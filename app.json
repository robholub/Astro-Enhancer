{
  "expo": {
    "name": "AstroEnhancer",
    "slug": "astro-enhancer",
    "version": "1.0.2",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#070A12"
    },
    "extra": {
      "eas": {
        "projectId": "67f10a15-9613-40a5-84fc-b4c7f66549c6"
      }
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.astroenhancer.app",
      "buildNumber": "1",
      "deploymentTarget": "15.1",
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "Select astrophotography images from your library for processing.",
        "NSPhotoLibraryAddUsageDescription": "Save enhanced astrophotography images to your photo library."
      }
    },
    "android": {
      "package": "com.robholub.astroenhancer",
      "versionCode": 3,
      "minSdkVersion": 26,
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#070A12"
      },
      "permissions": [
        "READ_MEDIA_IMAGES",
        "WRITE_EXTERNAL_STORAGE"
      ]
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow AstroEnhancer to open your astrophotography images."
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "Allow AstroEnhancer to access your photo library.",
          "savePhotosPermission": "Allow AstroEnhancer to save enhanced astrophotos.",
          "isAccessMediaLocationEnabled": true
        }
      ]
    ]
  }
}

